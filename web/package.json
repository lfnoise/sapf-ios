{
  "name": "sapf-web",
  "private": true,
  "version": "0.1.22",
  "description": "sapf (Sound As Pure Form) in the browser",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "engine": "sh scripts/build-engine.sh",
    "assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs && vite",
    "build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "puppeteer-core": "25.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
